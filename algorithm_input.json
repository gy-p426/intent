{
  "algorithms": {
    "cluster": {
      "name": "聚类分析 (K-Means)",
      "description": "执行K-Means聚类算法，将数据按相似性分组，用于客户分群、产品分类等",
      "api_endpoint": "/clustering/kmeans",
      "method": "POST",
      "required_fields": [
        {
          "field": "data_rows",
          "type": "array",
          "description": "待聚类的数据行，每行包含ID和特征值"
        },
        {
          "field": "id_column",
          "type": "string",
          "description": "数据行中的ID列名"
        },
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于聚类的特征列名集合"
        }
      ],
      "optional_fields": [
        {
          "field": "k_value",
          "type": "integer",
          "default": null,
          "description": "聚类数量，null时自动使用手肘法计算最佳K值"
        }
      ],
      "data_format": "tabular",
      "sql_template": "SELECT {id_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的数据行",
        "config": {
          "id_column": "ID列名",
          "feature_columns": "特征列名数组",
          "k_value": "聚类数量或null"
        }
      },
      "examples": [
        "将消费者按购买偏好分组",
        "将客户按消费行为进行分组",
        "根据用户特征自动分群"
      ]
    },
    "classify": {
      "name": "智能分类预测 (Auto-Routing)",
      "description": "智能路由分类接口，根据数据量自动选择XGBoost(小数据同步)或TabNet(大数据异步)算法",
      "api_endpoint": "/classification/predict",
      "method": "POST",
      "required_fields": [
        {
          "field": "data_rows",
          "type": "array",
          "description": "待预测的新数据行，不含标签"
        },
        {
          "field": "data_sets",
          "type": "array",
          "description": "用于训练的历史数据，含标签"
        },
        {
          "field": "id_column",
          "type": "string",
          "description": "数据行中的ID列名"
        },
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于分类的特征列名集合"
        },
        {
          "field": "target_column",
          "type": "string",
          "description": "分类目标列名(标签列)"
        }
      ],
      "optional_fields": [
        {
          "field": "categorical_columns",
          "type": "array",
          "default": [],
          "description": "类别型特征列名，用于自动编码"
        },
        {
          "field": "algorithm",
          "type": "string",
          "default": null,
          "options": ["xgboost", "tabnet", "null"],
          "description": "指定算法类型，null时自动根据数据量选择"
        }
      ],
      "data_format": "tabular",
      "sql_template_predict": "SELECT {id_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "sql_template_train": "SELECT {id_column}, {feature_columns}, {target_column} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data_rows": "待预测数据(从predict SQL获取)",
        "data_sets": "训练数据(从train SQL获取)",
        "config": {
          "id_column": "ID列名",
          "feature_columns": "特征列名数组",
          "categorical_columns": "类别列名数组",
          "target_column": "目标列名",
          "algorithm": "算法选择"
        }
      },
      "response_modes": {
        "sync": "小数据量使用XGBoost同步返回结果",
        "async": "大数据量使用TabNet异步处理，返回task_id"
      },
      "examples": [
        "判断邮件是否为垃圾邮件",
        "预测客户是否会流失",
        "泰坦尼克号乘客生存预测"
      ]
    },
    "predict": {
      "name": "预测分析",
      "description": "基于历史数据预测未来趋势，支持单变量和多变量预测",
      "api_endpoint": "/prediction/forecast",
      "method": "POST",
      "required_fields": [
        {
          "field": "timestamp_column",
          "type": "string",
          "description": "时间列名"
        },
        {
          "field": "target_column",
          "type": "string",
          "description": "预测目标列名"
        }
      ],
      "optional_fields": [
        {
          "field": "feature_columns",
          "type": "array",
          "default": null,
          "description": "特征列列表（多变量预测时使用，null时为单变量预测）"
        },
        {
          "field": "forecast_horizon",
          "type": "integer",
          "default": 14,
          "description": "预测步数（天数）"
        },
        {
          "field": "algorithm",
          "type": "string",
          "default": "auto",
          "options": ["auto", "prophet", "arima", "lightgbm", "xgboost", "random_forest", "linear_regression"],
          "description": "预测算法，auto时根据数据特征自动选择"
        },
        {
          "field": "model_name",
          "type": "string",
          "default": null,
          "description": "模型名称，用于保存和复用模型"
        }
      ],
      "data_format": "time_series",
      "sql_template": "SELECT {timestamp_column}, {target_column}, {feature_columns} FROM {table_name} WHERE {time_conditions} ORDER BY {timestamp_column}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的时间序列数据",
        "config": {
          "timestamp_column": "时间列名",
          "target_column": "目标列名",
          "feature_columns": "特征列数组或null",
          "forecast_horizon": "预测步数",
          "algorithm": "预测算法",
          "model_name": "模型名称或null"
        }
      },
      "sub_algorithms": {
        "univariate_forecast": {
          "name": "单变量预测",
          "description": "基于单一时间序列的预测，使用Prophet或ARIMA",
          "algorithms": ["prophet", "arima"],
          "examples": ["预测未来14天的销售额", "预测下周的用户活跃度"]
        },
        "multivariate_forecast": {
          "name": "多变量预测",
          "description": "基于多个特征的预测，使用机器学习算法",
          "algorithms": ["lightgbm", "xgboost", "random_forest", "linear_regression"],
          "examples": ["基于温度湿度预测能耗", "使用多特征预测销量"]
        }
      },
      "examples": [
        "预测未来14天的销售额",
        "预测下个月的用户活跃度",
        "基于历史数据预测设备故障",
        "使用lightgbm预测能耗",
        "预测股票价格走势"
      ]
    },
    "anomaly": {
      "name": "异常检测",
      "description": "识别数据中的异常点或异常模式，用于欺诈检测、设备故障等",
      "api_endpoint": "/anomaly/detect",
      "method": "POST",
      "required_fields": [
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于异常检测的特征列"
        }
      ],
      "optional_fields": [
        {
          "field": "threshold",
          "type": "float",
          "default": 0.05,
          "description": "异常阈值，异常比例"
        },
        {
          "field": "detection_method",
          "type": "string",
          "default": "isolation_forest",
          "options": ["isolation_forest", "one_class_svm", "local_outlier_factor"],
          "description": "异常检测方法"
        }
      ],
      "data_format": "tabular",
      "sql_template": "SELECT {feature_columns} FROM {table_name} WHERE {conditions}",
      "examples": [
        "检测交易数据中的异常点",
        "找出销售数据中的异常波动",
        "识别网络流量中的异常行为"
      ]
    },
    "associate": {
      "name": "关联分析",
      "description": "发现数据项之间的关联规则，用于购物篮分析、推荐系统等",
