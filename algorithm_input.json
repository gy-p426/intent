{
  "algorithms": {
    "cluster": {
      "name": "聚类分析 (K-Means)",
      "description": "执行K-Means聚类算法，将数据按相似性分组，用于客户分群、产品分类等",
      "api_endpoint": "/clustering/kmeans",
      "method": "POST",
      "required_fields": [
        {
          "field": "data_rows",
          "type": "array",
          "description": "待聚类的数据行，每行包含ID和特征值"
        },
        {
          "field": "id_column",
          "type": "string",
          "description": "数据行中的ID列名"
        },
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于聚类的特征列名集合"
        }
      ],
      "optional_fields": [
        {
          "field": "k_value",
          "type": "integer",
          "default": null,
          "description": "聚类数量，null时自动使用手肘法计算最佳K值"
        }
      ],
      "data_format": "tabular",
      "sql_template": "SELECT {id_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的数据行",
        "config": {
          "id_column": "ID列名",
          "feature_columns": "特征列名数组",
          "k_value": "聚类数量或null"
        }
      },
      "examples": [
        "将消费者按购买偏好分组",
        "将客户按消费行为进行分组",
        "根据用户特征自动分群"
      ]
    },
    "classify": {
      "name": "智能分类预测 (Auto-Routing)",
      "description": "智能路由分类接口，根据数据量自动选择XGBoost(小数据同步)或TabNet(大数据异步)算法",
      "api_endpoint": "/classification/predict",
      "method": "POST",
      "required_fields": [
        {
          "field": "data_rows",
          "type": "array",
          "description": "待预测的新数据行，不含标签"
        },
        {
          "field": "data_sets",
          "type": "array",
          "description": "用于训练的历史数据，含标签"
        },
        {
          "field": "id_column",
          "type": "string",
          "description": "数据行中的ID列名"
        },
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于分类的特征列名集合"
        },
        {
          "field": "target_column",
          "type": "string",
          "description": "分类目标列名(标签列)"
        }
      ],
      "optional_fields": [
        {
          "field": "categorical_columns",
          "type": "array",
          "default": [],
          "description": "类别型特征列名，用于自动编码"
        },
        {
          "field": "algorithm",
          "type": "string",
          "default": null,
          "options": ["xgboost", "tabnet", "null"],
          "description": "指定算法类型，null时自动根据数据量选择"
        }
      ],
      "data_format": "tabular",
      "sql_template_predict": "SELECT {id_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "sql_template_train": "SELECT {id_column}, {feature_columns}, {target_column} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data_rows": "待预测数据(从predict SQL获取)",
        "data_sets": "训练数据(从train SQL获取)",
        "config": {
          "id_column": "ID列名",
          "feature_columns": "特征列名数组",
          "categorical_columns": "类别列名数组",
          "target_column": "目标列名",
          "algorithm": "算法选择"
        }
      },
      "response_modes": {
        "sync": "小数据量使用XGBoost同步返回结果",
        "async": "大数据量使用TabNet异步处理，返回task_id"
      },
      "examples": [
        "判断邮件是否为垃圾邮件",
        "预测客户是否会流失",
        "泰坦尼克号乘客生存预测"
      ]
    },
    "predict": {
      "name": "预测分析",
      "description": "基于历史数据预测未来趋势，支持单变量和多变量预测",
      "api_endpoint": "/prediction/forecast",
      "method": "POST",
      "required_fields": [
        {
          "field": "timestamp_column",
          "type": "string",
          "description": "时间列名"
        },
        {
          "field": "target_column",
          "type": "string",
          "description": "预测目标列名"
        }
      ],
      "optional_fields": [
        {
          "field": "feature_columns",
          "type": "array",
          "default": null,
          "description": "特征列列表（多变量预测时使用，null时为单变量预测）"
        },
        {
          "field": "forecast_horizon",
          "type": "integer",
          "default": 14,
          "description": "预测步数（天数）"
        },
        {
          "field": "algorithm",
          "type": "string",
          "default": "auto",
          "options": ["auto", "prophet", "arima", "lightgbm", "xgboost", "random_forest", "linear_regression"],
          "description": "预测算法，auto时根据数据特征自动选择"
        },
        {
          "field": "model_name",
          "type": "string",
          "default": null,
          "description": "模型名称，用于保存和复用模型"
        }
      ],
      "data_format": "time_series",
      "sql_template": "SELECT {timestamp_column}, {target_column}, {feature_columns} FROM {table_name} WHERE {time_conditions} ORDER BY {timestamp_column}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的时间序列数据",
        "config": {
          "timestamp_column": "时间列名",
          "target_column": "目标列名",
          "feature_columns": "特征列数组或null",
          "forecast_horizon": "预测步数",
          "algorithm": "预测算法",
          "model_name": "模型名称或null"
        }
      },
      "sub_algorithms": {
        "univariate_forecast": {
          "name": "单变量预测",
          "description": "基于单一时间序列的预测，使用Prophet或ARIMA",
          "algorithms": ["prophet", "arima"],
          "examples": ["预测未来14天的销售额", "预测下周的用户活跃度"]
        },
        "multivariate_forecast": {
          "name": "多变量预测",
          "description": "基于多个特征的预测，使用机器学习算法",
          "algorithms": ["lightgbm", "xgboost", "random_forest", "linear_regression"],
          "examples": ["基于温度湿度预测能耗", "使用多特征预测销量"]
        }
      },
      "examples": [
        "预测未来14天的销售额",
        "预测下个月的用户活跃度",
        "基于历史数据预测设备故障",
        "使用lightgbm预测能耗",
        "预测股票价格走势"
      ]
    },
    "anomaly": {
      "name": "DBSCAN密度聚类-异常分析",
      "description": "密度聚类算法是一种基于数据点的局部密度分布，将密度相连的连续区域划分为同一聚类，同时能自然识别出任意形状聚类和孤立噪声点的无监督学习算法。",
      "api_endpoint": "/anomaly/dbscan",
      "method": "POST",
      "required_fields": [
        {
          "field": "data_rows",
          "type": "array",
          "description": "待分析的数据行，每行包含ID和特征值"
        },
        {
          "field": "id_column",
          "type": "string",
          "description": "用于标识每个数据点的ID列"
        },
        {
          "field": "feature_columns",
          "type": "array",
          "description": "用于聚类计算的数值型特征列"
        }
      ],
      "optional_fields": [],
      "data_format": "tabular",
      "sql_template": "SELECT {id_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的数据行",
        "config": {
          "id_column": "ID列名",
          "feature_columns": "特征列名数组",
          "preprocessing": {
            "handle_missing": true,
            "normalize_features": true
          }
        }
      },
      "data_requirements": {
        "min_features": 1,
        "max_features": 10,
        "min_rows": 1,
        "numeric_features_required": true
      },
      "examples": [
        "请帮我分析一下A分公司7-9月份销售数据有哪些异常？",
        "请帮我分析一下A传感器9.12日的数据是否有异常？",
        "检测交易数据中的异常点",
        "找出销售数据中的异常波动"
      ]
    },
    "associate": {
      "name": "多元关联分析",
      "description": "分析变量之间的关联关系，支持二元、多变量两两、多变量综合三种分析模式，用于发现数据列之间的统计关联",
      "api_endpoint": "/api/v1/association",
      "method": "POST",
      "required_fields": [
        {
          "field": "columns",
          "type": "array",
          "description": "需要分析关联的列名数组（列注释），至少2列"
        }
      ],
      "optional_fields": [
        {
          "field": "analysis_mode",
          "type": "string",
          "default": "auto",
          "options": ["bivariate", "pairwise", "multivariate", "auto"],
          "description": "分析模式：bivariate(二元，2列)、pairwise(两两，≥3列)、multivariate(综合，≥3列，第一列为因变量)，auto时根据列数自动推断"
        }
      ],
      "data_format": "multi_columns",
      "sql_template": "SELECT {columns} FROM {table_name} WHERE {conditions}",
      "payload_structure": {
        "data": "列数据数组，格式为[{name: 列名, values: [值...]}, ...]",
        "options": {
          "analysis_mode": "分析模式"
        }
      },
      "analysis_modes": {
        "bivariate": {
          "name": "二元关联分析",
          "description": "分析两个变量之间的关联关系",
          "required_columns": 2,
          "methods": ["卡方检验", "相关性分析", "方差分析"],
          "api_endpoint": "/api/v1/association/bivariate",
          "examples": ["分析年龄和薪资的关系", "分析性别与产品偏好的关联"]
        },
        "pairwise": {
          "name": "多变量两两关联分析",
          "description": "分析多个变量之间的两两关联关系，使用互信息方法",
          "min_columns": 3,
          "methods": ["互信息(MI)"],
          "api_endpoint": "/api/v1/association/pairwise",
          "examples": ["分析年龄、学历、工作年限之间的两两关联", "找出多个因素中哪些相互关联"]
        },
        "multivariate": {
          "name": "多变量综合关联分析",
          "description": "分析多个自变量与一个因变量的综合关联关系，第一列为因变量",
          "min_columns": 3,
          "methods": ["条件互信息(CMI)", "回归分析"],
          "api_endpoint": "/api/v1/association/multivariate",
          "examples": ["分析哪些因素影响薪资（薪资为因变量）", "分析多个自变量对因变量的综合影响"]
        }
      },
      "data_requirements": {
        "min_rows": 2,
        "min_columns": 2,
        "max_columns": null,
        "numeric_features_required": false,
        "same_length_required": true,
        "mode_specific": {
          "bivariate": {"exact_columns": 2},
          "pairwise": {"min_columns": 3},
          "multivariate": {"min_columns": 3, "note": "第一列为因变量"}
        }
      },
      "examples": [
        "分析教育水平与薪资的关系",
        "分析性别与产品偏好的关联",
        "分析年龄、学历、工作年限之间的关联关系",
        "分析哪些因素影响员工薪资",
        "找出影响销售额的关键因素"
      ]
    },
