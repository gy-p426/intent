          "default": 0.7,
          "description": "相似度阈值"
        }
      ],
      "data_format": "tabular",
      "sql_template": "SELECT {entity_column}, {feature_columns} FROM {table_name} WHERE {conditions}",
      "examples": [
        "计算两条曲线的相似度",
        "判断两篇文章的相似程度",
        "分析用户行为模式的相似性"
      ]
    },
    "trend": {
      "name": "趋势分析",
      "description": "分析数据的时间趋势和季节性模式，支持趋势分解（提取趋势、季节性、残差成分）和趋势检测（判断趋势方向和显著性）",
      "api_endpoint": "/api/v1/trend",
      "method": "POST",
      "required_fields": [
        {
          "field": "timestamp_column",
          "type": "string",
          "description": "时间列名"
        },
        {
          "field": "value_column",
          "type": "string",
          "description": "分析指标列名"
        }
      ],
      "optional_fields": [
        {
          "field": "analysis_type",
          "type": "string",
          "default": "decomposition",
          "options": ["decomposition", "detection"],
          "description": "分析类型：decomposition（趋势分解，提取趋势/季节性/残差）或 detection（趋势检测，判断趋势方向）"
        },
        {
          "field": "period",
          "type": "integer",
          "default": null,
          "description": "季节性周期，null时自动检测（如24表示小时数据的日周期，7表示日数据的周周期）"
        },
        {
          "field": "decomposition_model",
          "type": "string",
          "default": "additive",
          "options": ["additive", "multiplicative"],
          "description": "分解模型类型（仅用于decomposition）"
        },
        {
          "field": "algorithm",
          "type": "string",
          "default": "auto",
          "options": ["auto", "stl", "classical"],
          "description": "分解算法（仅用于decomposition）：auto自动选择，stl为STL分解，classical为经典分解"
        },
        {
          "field": "detection_method",
          "type": "string",
          "default": "auto",
          "options": ["auto", "mann_kendall", "linear_regression"],
          "description": "趋势检测方法（仅用于detection）：auto自动选择，mann_kendall为Mann-Kendall检验，linear_regression为线性回归"
        },
        {
          "field": "confidence_level",
          "type": "float",
          "default": 0.95,
          "description": "置信水平（仅用于detection），范围0.5-0.99"
        }
      ],
      "data_format": "time_series",
      "sql_template": "SELECT {timestamp_column}, {value_column} FROM {table_name} WHERE {time_conditions} ORDER BY {timestamp_column}",
      "payload_structure": {
        "data_rows": "从SQL查询获取的时间序列数据，格式为[{timestamp, value}, ...]",
        "config": {
          "timestamp_column": "时间列名",
          "value_column": "指标列名",
          "analysis_type": "decomposition或detection",
          "period": "季节性周期或null",
          "decomposition_model": "additive或multiplicative",
          "algorithm": "auto/stl/classical",
          "detection_method": "auto/mann_kendall/linear_regression",
          "confidence_level": "置信水平"
        }
      },
      "sub_algorithms": {
        "decomposition": {
          "name": "趋势分解",
          "description": "将时间序列分解为趋势、季节性和残差成分",
          "api_endpoint": "/api/v1/trend/decomposition",
          "algorithms": ["stl", "classical"],
          "examples": ["分解销售数据的趋势和季节性", "提取温度数据的周期性模式"]
        },
        "detection": {
          "name": "趋势检测",
          "description": "检测时间序列的趋势方向（上升/下降/无趋势）和统计显著性",
          "api_endpoint": "/api/v1/trend/detection",
          "algorithms": ["mann_kendall", "linear_regression"],
          "examples": ["检测销售额是否有上升趋势", "判断用户活跃度的变化方向"]
        }
      },
      "examples": [
        "分析销售数据的趋势变化",
        "分解数据的季节性模式",
        "检测销售额是否有上升趋势",
        "判断用户活跃度的变化方向",
        "提取温度数据的周期性模式"
      ]
    },
