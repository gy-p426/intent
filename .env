# ============================================
# 意图识别服务配置模板
# ============================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填写所有必需的配置项（标记为 [必需]）
# 3. 可选配置项已设置默认值，可根据需要修改
# ============================================

# --------------------------------------------
# 服务配置
# --------------------------------------------
# 服务名称（用于Nacos注册）
SERVICE_NAME=intent-recognition-service

# 服务监听端口
SERVICE_PORT=8000

# --------------------------------------------
# Nacos服务注册配置
# --------------------------------------------
# [必需] Nacos服务器地址，格式: host:port
# 示例: localhost:8848 或 nacos:8848（Docker环境）
NACOS_SERVER_ADDR=127.0.0.1:8848

# Nacos命名空间（默认: public）
NACOS_NAMESPACE=public

# --------------------------------------------
# 知识库配置
# --------------------------------------------
# 知识库文件路径（相对于项目根目录）
KNOWLEDGE_BASE_PATH=intent.txt

# RAG检索返回的候选微服务数量（范围: 1-100）
RAG_TOP_K=20

# --------------------------------------------
# 向量模型配置
# --------------------------------------------
# 文本向量化模型名称
# 推荐使用中文优化模型: shibing624/text2vec-base-chinese
EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# --------------------------------------------
# 火山引擎豆包大模型配置
# --------------------------------------------
# [必需] 火山引擎ARK API密钥
# 获取方式: https://console.volcengine.com/ark
ARK_API_KEY=7d7ec6e7-1f52-4deb-b881-7ea57442399f

# 豆包模型名称
# 可选模型: doubao-seed-1.6-250615, doubao-pro-32k 等
ARK_MODEL=deepseek-v3-2-251201

# LLM API超时时间（秒）
ARK_TIMEOUT=60

# LLM API调用失败最大重试次数
LLM_MAX_RETRIES=3

# LLM API重试间隔（秒）
LLM_RETRY_DELAY=2

# --------------------------------------------
# 日志配置
# --------------------------------------------
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --------------------------------------------
# 算法集成服务配置
# --------------------------------------------
# 算法配置文件路径
ALGORITHM_CONFIG_PATH=algorithm_input.json

# 是否启用算法配置热重载
ALGORITHM_CONFIG_HOT_RELOAD=true

# 配置文件检查间隔（秒）
ALGORITHM_CONFIG_RELOAD_INTERVAL=60

# --------------------------------------------
# 服务发现配置
# --------------------------------------------
# 是否启用Nacos服务发现（true/false）
SERVICE_DISCOVERY_ENABLED=true

# 服务发现模式：nacos 或 static
SERVICE_DISCOVERY_MODE=nacos

# 负载均衡策略：round_robin, random, least_connections
LOAD_BALANCE_STRATEGY=round_robin

# 服务健康检查间隔（秒）
SERVICE_HEALTH_CHECK_INTERVAL=30

# --------------------------------------------
# NL2SQL服务配置
# --------------------------------------------
# Nacos服务名称（启用服务发现时使用）
NL2SQL_SERVICE_NAME=nl2sql-service

# 静态URL（禁用服务发现时使用）
NL2SQL_BASE_URL=http://localhost:8081

# 请求配置
NL2SQL_TIMEOUT=30
NL2SQL_MAX_RETRIES=3
NL2SQL_RETRY_DELAY=2

# ============================================
# Agent算法分析配置
# ============================================

# Agent算法分析服务地址
AGENT_ALGORITHM_ANALYSIS_URL=http://localhost:8999

# Agent算法分析超时时间（秒），建议设置为5分钟
AGENT_ALGORITHM_ANALYSIS_TIMEOUT=300

# 是否启用Agent算法分析
ENABLE_AGENT_ALGORITHM_ANALYSIS=true

# --------------------------------------------
# 算法API服务配置
# --------------------------------------------
# 聚类算法服务
CLUSTERING_SERVICE_NAME=clustering-service
# CLUSTERING_API_URL=http://PlumdeMac-mini.local:8000
CLUSTERING_API_URL=http://202.115.16.67:8000/api/bi-class-service

# 分类算法服务
CLASSIFICATION_SERVICE_NAME=classification-service
CLASSIFICATION_API_URL=http://localhost:8000/api/bi-class-service

# 预测算法服务-眭阳天
PREDICTION_SERVICE_NAME=prediction-service
# PREDICTION_API_URL=http://localhost:8100
PREDICTION_API_URL=http://localhost:8000/api/trend_forecast

# 异常检测服务（统一使用DBSCAN服务）-石际哲
ANOMALY_SERVICE_NAME=dbscan-service
ANOMALY_API_URL=http://localhost:8000/api/abnormal_service
DBSCAN_API_URL=http://localhost:8000/api/abnormal_service

# 关联分析服务-马健鸿
ASSOCIATION_SERVICE_NAME=association-service
ASSOCIATION_API_URL=http://localhost:8000/api/association-service

# 对比分析服务
COMPARISON_SERVICE_NAME=comparison-service
COMPARISON_API_URL=http://localhost:8000/api/comparison-service

# 相似度分析服务
SIMILARITY_SERVICE_NAME=similarity-service
SIMILARITY_API_URL=http://localhost:8000/api/similarity-service

# 趋势分析服务-眭阳天
TREND_SERVICE_NAME=trend-service
# TREND_API_URL=http://localhost:8100
TREND_API_URL=http://localhost:8000/api/trend_forecast
FORECAST_SERVICE_URL=http://localhost:8000/api/trend_forecast

# 用户画像服务
PROFILE_SERVICE_NAME=profile-service
PROFILE_API_URL=http://localhost:8009

# 因果分析服务
CAUSALITY_SERVICE_NAME=causality-service
CAUSALITY_API_URL=http://localhost:8000/api/causal-service

# 预警系统服务
ALERT_SERVICE_NAME=alert-service
ALERT_API_URL=http://localhost:8011

# 推荐系统服务
RECOMMENDATION_SERVICE_NAME=recommendation-service
RECOMMENDATION_API_URL=http://localhost:8012

# 占比分析系统服务
COMPARE_PROPORTION_SERVICE_NAME=compare_proportion-service
COMPARE_PROPORTION_API_URL=http://localhost:8000/api/compare_proportion

# 算法API通用配置
ALGORITHM_API_TIMEOUT=60
ALGORITHM_API_MAX_RETRIES=3
ALGORITHM_API_RETRY_DELAY=2

# 异步任务配置
ASYNC_TASK_POLL_INTERVAL=5
ASYNC_TASK_MAX_WAIT_TIME=300
ASYNC_TASK_MAX_CONCURRENT=10

# 流式响应配置
STREAM_CHUNK_SIZE=1024
STREAM_TIMEOUT=120
STREAM_BUFFER_SIZE=8192

# 健康检查配置
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# --------------------------------------------
# 大模型结果分析配置
# --------------------------------------------
# 是否启用大模型结果分析
ENABLE_LLM_RESULT_ANALYSIS=true

# 用于结果分析的大模型（默认使用与算法识别相同的模型）
LLM_ANALYSIS_MODEL=deepseek-v3-2-251201

# 大模型分析超时时间（秒）
LLM_ANALYSIS_TIMEOUT=30

# 大模型分析最大重试次数
LLM_ANALYSIS_MAX_RETRIES=2

# 是否启用分析失败时的降级处理
LLM_ANALYSIS_FALLBACK_ENABLED=true

# --------------------------------------------
# 算法类型识别配置
# --------------------------------------------
# 是否启用纯大模型算法类型识别
# true: 使用纯LLM方法，准确率更高，响应更快
# false: 使用传统RAG+关键词方法，作为备选方案
ENABLE_PURE_LLM_ALGORITHM_DETECTION=true

# 用于算法类型识别的大模型（建议与ARK_MODEL保持一致）
ALGORITHM_DETECTION_MODEL=deepseek-v3-2-251201

# 算法识别超时时间（秒）
ALGORITHM_DETECTION_TIMEOUT=30

# 算法识别最大重试次数
ALGORITHM_DETECTION_MAX_RETRIES=2

# --------------------------------------------
# 数据库配置（用于获取表结构信息）
# --------------------------------------------
# [必需] MySQL数据库主机地址
MYSQL_HOST=localhost

# MySQL数据库端口
MYSQL_PORT=3306

# [必需] MySQL数据库名（包含table_columns表）
MYSQL_DATABASE=nl2sql

# [必需] MySQL用户名
MYSQL_USERNAME=root

# [必需] MySQL密码
MYSQL_PASSWORD=root

# ============================================
# 配置说明
# ============================================
# 
# 1. 环境变量优先级高于.env文件
# 2. 所有配置项都可以通过环境变量覆盖
# 3. 环境变量名称不区分大小写
# 4. 必需配置项缺失时服务将拒绝启动
# 
# Docker部署示例:
# docker run -e NACOS_SERVER_ADDR=nacos:8848 \
#            -e ARK_API_KEY=your_key \
#            -e MYSQL_HOST=mysql \
#            -e MYSQL_PASSWORD=your_password \
#            intent-recognition-service
# 
# ============================================
